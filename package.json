{
	"name": "obsidian-sample-plugin",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "rolldown --config --watch",
		"build": "tsc -noEmit -skipLibCheck && rolldown --config",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix --cache",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"check-all": "pnpm typecheck && pnpm lint && pnpm lint:eslint && pnpm fmt:check && pnpm build"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "0.3.0",
		"eslint-plugin-oxlint": "^1.66.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"rolldown": "^1.0.1",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.59.4"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
